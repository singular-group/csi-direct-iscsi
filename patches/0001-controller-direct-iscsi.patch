From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sergi Alberich <salberich@singulargroup.com>
Date: Wed, 11 Nov 2026 09:28:31 +0100
Subject: [PATCH 1/3] cinder-csi-plugin: direct iSCSI hooks in the controller

---
 pkg/csi/cinder/controllerserver.go | 26 ++++++++++++++++----------
 1 file changed, 16 insertions(+), 10 deletions(-)

diff --git a/pkg/csi/cinder/controllerserver.go b/pkg/csi/cinder/controllerserver.go
index 1a1b9e2..89d65f6 100644
--- a/pkg/csi/cinder/controllerserver.go
+++ b/pkg/csi/cinder/controllerserver.go
@@ -35,6 +35,7 @@ import (
 	"google.golang.org/protobuf/types/known/timestamppb"
 
 	sharedcsi "k8s.io/cloud-provider-openstack/pkg/csi"
+	"k8s.io/cloud-provider-openstack/pkg/csi/cinder/directiscsi"
 	"k8s.io/cloud-provider-openstack/pkg/csi/cinder/openstack"
 	"k8s.io/cloud-provider-openstack/pkg/util"
 	cpoerrors "k8s.io/cloud-provider-openstack/pkg/util/errors"
@@ -196,7 +197,7 @@ func (cs *controllerServer) CreateVolume(ctx context.Context, req *csi.CreateVol
 	opts := &volumes.CreateOpts{
 		Name:             volName,
 		Size:             volSizeGB,
-		VolumeType:       volType,
+		VolumeType:       directiscsi.VolumeTypeForCreate(ctx, cloud, volType),
 		AvailabilityZone: volAvailability,
 		SnapshotID:       snapshotID,
 		SourceVolID:      sourceVolID,
@@ -273,6 +274,9 @@ func (cs *controllerServer) DeleteVolume(ctx context.Context, req *csi.DeleteVol
 	if len(volID) == 0 {
 		return nil, status.Error(codes.InvalidArgument, "DeleteVolume Volume ID must be provided")
 	}
+	if err := directiscsi.BeforeDeleteVolume(ctx, cloud, volID); err != nil {
+		return nil, err
+	}
 	err := cloud.DeleteVolume(ctx, volID)
 	if err != nil {
 		if cpoerrors.IsNotFound(err) {
@@ -313,6 +317,10 @@ func (cs *controllerServer) ControllerPublishVolume(ctx context.Context, req *cs
 		return nil, status.Error(codes.InvalidArgument, "[ControllerPublishVolume] Volume capability must be provided")
 	}
 
+	if resp, handled, err := directiscsi.ControllerPublish(ctx, cloud, volumeID, instanceID); handled {
+		return resp, err
+	}
+
 	_, err := cloud.GetVolume(ctx, volumeID)
 	if err != nil {
 		if cpoerrors.IsNotFound(err) {
@@ -376,6 +384,11 @@ func (cs *controllerServer) ControllerUnpublishVolume(ctx context.Context, req *
 	if len(volumeID) == 0 {
 		return nil, status.Error(codes.InvalidArgument, "[ControllerUnpublishVolume] Volume ID must be provided")
 	}
+	if direct, err := directiscsi.ControllerUnpublish(ctx, cloud, volumeID); err != nil {
+		return nil, err
+	} else if direct {
+		return &csi.ControllerUnpublishVolumeResponse{}, nil
+	}
 	_, err := cloud.GetInstanceByID(ctx, instanceID)
 	if err != nil {
 		if cpoerrors.IsNotFound(err) {
@@ -411,11 +424,7 @@ func (cs *controllerServer) ControllerUnpublishVolume(ctx context.Context, req *
 }
 
 func (cs *controllerServer) extractNodeIDs(attachments []volumes.Attachment) []string {
-	nodeIDs := make([]string, len(attachments))
-	for i, attachment := range attachments {
-		nodeIDs[i] = attachment.ServerID
-	}
-	return nodeIDs
+	return directiscsi.PublishedNodeIDs(attachments)
 }
 
 func (cs *controllerServer) createVolumeEntries(vlist []volumes.Volume) []*csi.ListVolumesResponse_Entry {
@@ -965,10 +974,7 @@ func (cs *controllerServer) ControllerGetVolume(ctx context.Context, req *csi.Co
 	}
 
 	status := &csi.ControllerGetVolumeResponse_VolumeStatus{}
-	status.PublishedNodeIds = make([]string, 0, len(volume.Attachments))
-	for _, attachment := range volume.Attachments {
-		status.PublishedNodeIds = append(status.PublishedNodeIds, attachment.ServerID)
-	}
+	status.PublishedNodeIds = directiscsi.PublishedNodeIDs(volume.Attachments)
 	ventry.Status = status
 
 	return &ventry, nil
